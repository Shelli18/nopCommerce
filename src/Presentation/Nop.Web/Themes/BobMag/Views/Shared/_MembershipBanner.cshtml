@*
    Free Shipping Banner - Small, subtle banner at very top
*@
<div class="free-shipping-banner">
    KOSTENLOSER VERSAND AB 50€ BESTELLWERT³
</div>

@* Newsletter Modal Dialog *@
<div id="newsletter-modal" class="newsletter-modal" style="display: none;">
    <div class="newsletter-modal-overlay"></div>
    <div class="newsletter-modal-content">
        <button class="newsletter-modal-close" aria-label="Schließen">&times;</button>

        <div class="newsletter-modal-body">
            <h2 class="newsletter-modal-title">Newsletter Anmeldung</h2>
            <p class="newsletter-modal-intro">Melde dich für unseren Newsletter an und erhalte 250 Bonuspunkte!</p>

            <div class="newsletter-modal-form" id="newsletter-modal-form">
                <div class="newsletter-email-field">
                    <input type="email" id="newsletter-modal-email" placeholder="Deine E-Mail-Adresse" aria-label="E-Mail-Adresse" />
                </div>

                <div class="newsletter-modal-disclaimer">
                    <label class="newsletter-consent-label">
                        <input type="checkbox" id="newsletter-modal-consent" required />
                        Ich möchte den Newsletter erhalten.
                        <a href="#" id="newsletter-modal-info-toggle" class="newsletter-info-link">Weitere Infos</a>
                    </label>
                    <div id="newsletter-modal-legal-text" class="newsletter-legal-text" style="display: none;">
                        Ich möchte den Newsletter der Plattform bob-mag.de, betrieben von Marcel Grunert Bob-Mag.de, erhalten und über Angebote, Trends und Aktionen, die auf der Plattform angeboten werden, per E-Mail informiert werden. Diese Einwilligung kann jederzeit mit Wirkung für die Zukunft unter <a href="https://www.bob-mag.de/customer/info">www.bob-mag.de/abmelden</a> oder am Ende jeder E-Mail widerrufen werden.
                    </div>
                </div>

                <button type="button" id="newsletter-modal-subscribe-button" class="button-1 newsletter-modal-subscribe-button">JETZT ANMELDEN</button>

                <div class="newsletter-modal-validation">
                    <span id="newsletter-modal-loading" style="display: none;" class="please-wait">Bitte warten...</span>
                </div>
            </div>

            <div class="newsletter-modal-result" id="newsletter-modal-result" style="display: none;"></div>
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(function() {
        // Open modal
        $('#membership-signup-trigger').on('click', function(e) {
            e.preventDefault();
            $('#newsletter-modal').fadeIn(300);
            $('body').css('overflow', 'hidden'); // Prevent background scrolling
        });

        // Close modal - X button
        $('.newsletter-modal-close').on('click', function() {
            $('#newsletter-modal').fadeOut(300);
            $('body').css('overflow', '');
        });

        // Close modal - Click on overlay
        $('.newsletter-modal-overlay').on('click', function() {
            $('#newsletter-modal').fadeOut(300);
            $('body').css('overflow', '');
        });

        // Close modal - ESC key
        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $('#newsletter-modal').is(':visible')) {
                $('#newsletter-modal').fadeOut(300);
                $('body').css('overflow', '');
            }
        });

        // Toggle legal text in modal
        $('#newsletter-modal-info-toggle').on('click', function(e) {
            e.preventDefault();
            var $legalText = $('#newsletter-modal-legal-text');
            var $link = $(this);

            if ($legalText.is(':visible')) {
                $legalText.slideUp(300);
                $link.removeClass('expanded').text('Weitere Infos');
            } else {
                $legalText.slideDown(300);
                $link.addClass('expanded').text('Weniger Infos');
            }
        });

        // Newsletter subscribe from modal
        $('#newsletter-modal-subscribe-button').on('click', async function() {
            // Check consent checkbox
            if (!$('#newsletter-modal-consent').is(':checked')) {
                alert('Bitte bestätigen Sie die Datenschutzerklärung.');
                return;
            }

            var email = $('#newsletter-modal-email').val();
            if (!email || email.trim() === '') {
                alert('Bitte geben Sie eine gültige E-Mail-Adresse ein.');
                return;
            }

            var $loading = $('#newsletter-modal-loading');
            $loading.show();

            var postData = {
                subscribe: true,
                email: email,
                'g-recaptcha-response': '' // Add captcha if needed
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.RouteUrl(NopRouteNames.Ajax.SUBSCRIBE_NEWSLETTER))",
                data: postData,
                    success: function (data, textStatus, jqXHR) {
                        $('#newsletter-modal-result').html(data.Result);
                        if (data.Success) {
                            $('#newsletter-modal-form').hide();
                            $('#newsletter-modal-result').show();

                            // Auto-close modal after 3 seconds on success
                            setTimeout(function() {
                                $('#newsletter-modal').fadeOut(300);
                                $('body').css('overflow', '');
                                // Reset form
                                $('#newsletter-modal-email').val('');
                                $('#newsletter-modal-consent').prop('checked', false);
                                $('#newsletter-modal-form').show();
                                $('#newsletter-modal-result').hide();
                            }, 3000);
                        } else {
                            $('#newsletter-modal-result').show();
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        alert('Newsletter-Anmeldung fehlgeschlagen. Bitte versuchen Sie es später erneut.');
                    },
                complete: function (jqXHR, textStatus) {
                    $loading.hide();
                }
            });
        });
    });
</script>
