@using Nop.Core.Domain.Catalog
@using Nop.Services.Helpers

@inject CatalogSettings catalogSettings
@inject IThemeContext themeContext
@inject IUserAgentHelper userAgentHelper

@{
    Layout = "";
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var supportRtl = await Html.ShouldUseRtlThemeAsync();

    // === CSS REGISTRIERUNG ===

    // 1. Load CleanDefault CSS first as base (update-safe foundation)
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/cleandefault.css");

    // 2. Then load our custom compiled SCSS (overrides CleanDefault)
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/styles{(supportRtl ? ".rtl" : "")}.css");

    // 3. Add swiper css file (if needed)
    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    // 4. Add jQuery UI css file
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");

    // === JAVASCRIPT REGISTRIERUNG ===

    // Add shrinking header script
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/shrinking-header.js");

    // Add mobile navigation script
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/mobile-navigation.js");
}